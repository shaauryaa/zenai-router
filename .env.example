# Names only. Copy to .env and fill in real values. .env is gitignored; this repo is public, so never put a
# key, password or real email address in any tracked file.

# LLM provider: gemini | azure. Overrides provider.name in config.yaml.
LLM_PROVIDER=
GEMINI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_KEY=
# Azure deployment names; override the ones in config.yaml when set.
AZURE_CHAT_DEPLOYMENT=
AZURE_EMBED_DEPLOYMENT=

# Knowledge-base search. RETRIEVER: azure (Azure AI Search) | local (in-process, no Azure needed).
AZURE_SEARCH_ENDPOINT=
AZURE_SEARCH_ADMIN_KEY=
SEARCH_INDEX=
RETRIEVER=

# Email for approved handoffs. EMAIL_PROVIDER: smtp | acs | outbox (outbox only writes to .data/, sends nothing).
EMAIL_PROVIDER=
ACS_CONNECTION_STRING=
ACS_SENDER=
DEMO_GMAIL=
GMAIL_APP_PASSWORD=

# Server
APP_SECRET=
STAFF_PASSWORD_IT=
STAFF_PASSWORD_FINANCE=
STAFF_PASSWORD_ACADEMICS=
STAFF_PASSWORD_HOSTEL=
STAFF_PASSWORD_CAMPUS_SERVICES=
STAFF_PASSWORD_EMPLOYEES=
STAFF_PASSWORD_STUDENT_SUPPORT=
STAFF_PASSWORD_HELPDESK=
WEB_ORIGIN=
DEMO_MODE=
